# ------------------------------------------------------------------
# AI StudyOS — backend environment template
# Copy to backend/.env  (or root .env) and fill in real values.
# NEVER commit real .env files to git.
# ------------------------------------------------------------------

# --- Database (REQUIRED) ---
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
# Docker Compose default matches docker-compose.yml below.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/aistudyos

# --- Auth / JWT (REQUIRED from Phase 1 onward, stubbed in Phase 0) ---
# Generate with: py -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- App ---
APP_ENV=development
APP_NAME=AI StudyOS
BACKEND_CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# --- LLM (REQUIRED from Phase 3 onward, NOT needed for Phase 0) ---
# Use exactly ONE provider. Free tier is enough.
# OpenAI example:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
#
# Gemini example:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-1.5-flash
# GOOGLE_API_KEY=AIza...
#
# Anthropic example:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-haiku-20240307
# ANTHROPIC_API_KEY=sk-ant-...
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
